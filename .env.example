# Base de datos
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/inmobiliaria"

# JWT
JWT_SECRET="change-this-secret-in-production"
JWT_EXPIRES_IN="15m"
REFRESH_TOKEN_EXPIRES_IN="7d"

# Servidor
PORT=3001
NODE_ENV=development

# CORS (frontend URL)
FRONTEND_URL="http://localhost:5173"

# Email (Resend) — https://resend.com
RESEND_API_KEY=""
RESEND_FROM_EMAIL="Inmobiliaria <noreply@tudominio.com>"

# Automatizaciones
BNA_INTEREST_RATE="0.40"           # Tasa anual BNA para mora (40% = 0.40)
ADMIN_WHATSAPP_PHONE="1150001234"   # Teléfono del admin sin 0 ni 15 (ej: 1150001234)
